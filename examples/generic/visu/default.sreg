# default experiment file that is loaded when the gui starts up

- Name: RunSystem

  DoublePendulum:

  Trajectory:
    Type: 1
    times: [0, 1]
    values: [0, 0.15]

  Visu:
    MplDoublePendulumVisualizer:

  Config:
    MovingWindowEnable: True  # Enable windowing
    MovingWindowSize: 10 # Show past 10 seconds of measurements
    HeartbeatTime: 250  # [ms], the rig stops the experiment after 1 s without heartbeat
